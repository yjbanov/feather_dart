# GN build file mounted into `//third_party/sdk/feather_dart/BUILD.gn` by
# `tools/fetch_dart_sdk.py`. Builds the stripped FeatherDart platform `.dill`
# and VM variants (with zero `//runtime/bin` / `dart:io` / BoringSSL / zlib).

import("//utils/compile_platform.gni")

compile_platform("feather_dart_platform") {
  single_root_scheme = "org-dartlang-sdk"
  single_root_base = rebase_path("//")
  libraries_specification_uri =
      "org-dartlang-sdk:///sdk/lib/libraries_feather_dart.json"
  outputs = [
    "$root_out_dir/feather_dart_platform_strong.dill",
    "$root_out_dir/feather_dart_outline_strong.dill",
  ]
  args = [
    "--target=feather_dart",
    "dart:core",
    "-Ddart.vm.product=true",
    "-Ddart.isVM=true",
    "--nnbd-strong",
    "--exclude-source",
  ]
}

config("feather_dart_public_config") {
  include_dirs = [
    "include",
    "//runtime/include",
  ]
}

_embedder_sources = [
  "include/feather_dart.h",
  "src/feather_dart.cc",
  "src/timer_fallback.cc",
  "src/timer_fallback.h",
]

if (is_ios) {
  static_library("feather_dart_aot") {
    complete_static_lib = true
    sources = _embedder_sources
    include_dirs = [ "src" ]
    public_configs = [ ":feather_dart_public_config" ]
    deps = [ "//runtime:libdart_aotruntime_product" ]
  }
} else {
  shared_library("feather_dart_aot") {
    output_name = "feather_dart"
    sources = _embedder_sources
    include_dirs = [ "src" ]
    public_configs = [ ":feather_dart_public_config" ]
    deps = [ "//runtime:libdart_aotruntime_product" ]
    if (is_mac) {
      ldflags = [ "-Wl,-install_name,@rpath/libfeather_dart.dylib" ]
    }
    if (is_linux || is_android) {
      ldflags = [
        "-Wl,--gc-sections",
        "-Wl,--exclude-libs,ALL",
      ]
      libs = [ "dl" ]
    }
    if (is_android) {
      libs += [ "log" ]
    }
  }

  shared_library("feather_dart_jit") {
    output_name = "feather_dart_jit"
    sources = _embedder_sources
    include_dirs = [ "src" ]
    public_configs = [ ":feather_dart_public_config" ]
    deps = [ "//runtime:libdart_jit" ]
    if (is_mac) {
      ldflags = [ "-Wl,-install_name,@rpath/libfeather_dart_jit.dylib" ]
    }
    if (is_linux || is_android) {
      libs = [ "dl" ]
    }
    if (is_android) {
      libs += [ "log" ]
    }
  }
}
